# Postgres (Supabase) — même projet que NEXT_PUBLIC_SUPABASE_URL / auth.
# Perf : utiliser le pooler **transaction** (port 6543), pas session (5432), ex. :
# DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres
# Mot de passe avec @ # % … : encoder en URL (ex. @ → %40).
#
# Pour Next.js en local : préférer l’URI **directe** `postgresql://...@db.<ref>.supabase.co:5432/postgres`
# (pas le pooler « session », limite ~15 connexions globales → erreur EMAXCONNSESSION).
# Migrations / scripts lourds : directe ou pooler session ; le pooler transaction (6543) ne convient pas au DDL.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
# Modèle Claude pour la synthèse RAG (défaut : claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Bornes de génération de la synthèse (défauts : 0.2 / 1500 / seuil 50 %)
# SYNTHESIS_TEMPERATURE=0.2
# SYNTHESIS_MAX_TOKENS=1500
# SYNTHESIS_MIN_CHUNK_SCORE=50
# Limite de synthèses IA par utilisateur et par heure (défaut : 30)
# Nécessite la migration : npm run db:ai-calls
# SYNTHESIS_RATE_LIMIT_PER_HOUR=30

VOYAGE_API_KEY=
# Optionnel — défaut voyage-law-2 (1024 dimensions, voir chunks.embedding)
# VOYAGE_EMBEDDING_MODEL=voyage-law-2

# SMTP — emails transactionnels applicatifs (invitations, notifications).
# Exemple PrivateEmail / Namecheap : mail.privateemail.com:465 (implicit TLS).
# Pour les emails d'auth Supabase : Authentication → SMTP Settings (dashboard).
# Sender name : « Adili Votre assistant Juridique » (sinon affichage « Supabase Auth »).
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@adili.cloud
SMTP_PASS=
SMTP_FROM="Adili <support@adili.cloud>"

# Optionnel — URL absolue du site pour les liens dans les emails et le callback OAuth.
# NEXT_PUBLIC_SITE_URL=https://adili.cloud

# Facturation & quotas IA (migration : npm run db:billing)
# BILLING_DEV_GRANT_PACKS=true
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_NOTIFY_URL=
# CINETPAY_RETURN_URL=
# CRON_SECRET=
# ADILI_BANK_RIB=
# ADILI_BANK_NAME=
# ADILI_BANK_TITULAIRE=
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Buckets Supabase Storage (privés) : paiements, factures, etudiants

# Session navigateur (mon espace / recherche connectée) : alerte + compte à rebours avant déconnexion.
# NEXT_PUBLIC_SESSION_IDLE_MINUTES=20
# NEXT_PUBLIC_SESSION_IDLE_COUNTDOWN_SECONDS=60
